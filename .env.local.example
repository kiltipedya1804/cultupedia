# ── Base de données ──────────────────────────────────────
# Supabase (recommandé)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Ou Neon
# DATABASE_URL=postgresql://[USER]:[PASSWORD]@[HOST]/cultupedia?sslmode=require

# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[SERVICE_ROLE_KEY]

# ── Admin ─────────────────────────────────────────────────
# Clé secrète pour les routes admin (générez une clé aléatoire)
ADMIN_API_KEY=votre_cle_secrete_ici
NEXT_PUBLIC_ADMIN_KEY=votre_cle_secrete_ici

# ── Cloudinary (optionnel — pour les images) ─────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Site ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://cultupedia.ht
